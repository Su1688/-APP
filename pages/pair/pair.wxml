<view class="page pair">
  <view wx:if="{{!cloudOn}}" class="notice">
    <view class="notice__title">还没配置云开发</view>
    <view class="notice__text">
      现在跑的是单机模式，一切存在本机。想两台手机同步，先按 README 开通云开发并把环境 ID 填进 config/cloud.js。
    </view>
  </view>

  <block wx:if="{{cloudOn}}">
    <block wx:if="{{loading}}">
      <view class="loading">正在连接…</view>
    </block>

    <block wx:elif="{{kitchen}}">
      <view class="hero">
        <view class="hero__emoji">🏡</view>
        <view class="hero__title">我们已经是一家人了</view>
        <view class="hero__sub">
          {{kitchen.memberCount === 2 ? '两台设备已经连上，点菜实时同步' : '还差一个人，把邀请码发给 TA'}}
        </view>
      </view>

      <view class="code-card">
        <view class="code-card__label">邀请码</view>
        <view class="code-card__value">{{kitchen.code}}</view>
        <view class="code-card__tip">让 TA 打开小程序 → 我的 → 我们的小家 → 输入这 6 位</view>
        <view class="code-card__btn" bindtap="onCopyCode">复制邀请码</view>
      </view>

      <view class="members">
        <view class="member">
          <text class="member__emoji">🙋</text>
          <text class="member__text">已连接</text>
        </view>
        <view class="members__line"></view>
        <view class="member {{kitchen.memberCount === 2 ? '' : 'member--empty'}}">
          <text class="member__emoji">{{kitchen.memberCount === 2 ? '🙋' : '➕'}}</text>
          <text class="member__text">{{kitchen.memberCount === 2 ? '已连接' : '等 TA 加入'}}</text>
        </view>
      </view>

      <view class="sync-note">菜单、订单和口味偏好会自动同步；购物车和收藏是你自己的，不会同步。</view>

      <view class="btn btn--ghost pair__wide" bindtap="onSyncNow">立即同步</view>
      <view class="btn btn--plain pair__wide" bindtap="onLeave">退出小家</view>
    </block>

    <block wx:else>
      <view class="hero">
        <view class="hero__emoji">🏡</view>
        <view class="hero__title">我们的小家</view>
        <view class="hero__sub">两个人连上以后，她点的菜你这台手机也能看到</view>
      </view>

      <view class="card action">
        <view class="action__title">第一次用，先建一个</view>
        <view class="action__sub">会生成一个 6 位邀请码，发给 TA 就能加入</view>
        <view class="btn btn--primary action__btn" bindtap="onCreate">
          {{busy ? '处理中…' : '创建我们的小家'}}
        </view>
      </view>

      <view class="card action">
        <view class="action__title">TA 已经建好了</view>
        <view class="action__sub">把 TA 给你的 6 位邀请码输在这里</view>
        <input
          class="action__input"
          value="{{codeInput}}"
          maxlength="6"
          placeholder="例如 8F3K2M"
          placeholder-class="ph"
          bindinput="onCodeInput"
        />
        <view class="btn btn--ghost action__btn" bindtap="onJoin">
          {{busy ? '处理中…' : '加入'}}
        </view>
      </view>
    </block>
  </block>
</view>
