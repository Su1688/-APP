.pair {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.notice {
  padding: 32rpx;
  border-radius: 26rpx;
  background: #fff6e5;
}

.notice__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #b3812f;
}

.notice__text {
  margin-top: 12rpx;
  color: #a8813f;
  font-size: 24rpx;
  line-height: 1.6;
}

.loading {
  padding: 120rpx 0;
  color: #9a8f8a;
  font-size: 26rpx;
  text-align: center;
}

.hero {
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ffe7d9 0%, #ffdcc9 100%);
  text-align: center;
}

.hero__emoji {
  font-size: 84rpx;
  line-height: 1.1;
}

.hero__title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #5a3324;
}

.hero__sub {
  margin-top: 10rpx;
  color: #a87a63;
  font-size: 23rpx;
}

.code-card {
  margin-top: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(226, 160, 130, 0.14);
  text-align: center;
}

.code-card__label {
  color: #9a8f8a;
  font-size: 24rpx;
}

.code-card__value {
  margin-top: 14rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #ff6b4a;
  letter-spacing: 10rpx;
}

.code-card__tip {
  margin-top: 16rpx;
  color: #bcb2ad;
  font-size: 22rpx;
  line-height: 1.6;
}

.code-card__btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  background: #ffe9e2;
  color: #ff6b4a;
  font-size: 26rpx;
  font-weight: 600;
}

.members {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 30rpx 0;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(226, 160, 130, 0.12);
}

.member {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.member__emoji {
  font-size: 48rpx;
}

.member__text {
  margin-top: 8rpx;
  color: #12a594;
  font-size: 22rpx;
}

.member--empty .member__text {
  color: #bcb2ad;
}

.members__line {
  width: 1rpx;
  height: 60rpx;
  background: #f3e9e3;
}

.sync-note {
  margin-top: 24rpx;
  color: #9a8f8a;
  font-size: 22rpx;
  line-height: 1.6;
}

.pair__wide {
  width: 100%;
  margin-top: 22rpx;
}

.action {
  margin-top: 24rpx;
  padding: 32rpx;
}

.action__title {
  font-size: 30rpx;
  font-weight: 700;
}

.action__sub {
  margin-top: 8rpx;
  color: #9a8f8a;
  font-size: 23rpx;
}

.action__input {
  height: 92rpx;
  margin-top: 22rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #fdf8f5;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  text-align: center;
}

.action__btn {
  width: 100%;
  margin-top: 22rpx;
}

.ph {
  color: #c9bdb6;
  font-size: 26rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}
