.summary {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffe7d9 0%, #ffdcc9 100%);
}

.summary__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary__num {
  font-size: 44rpx;
  font-weight: 700;
  color: #5a3324;
  line-height: 1.2;
}

.summary__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a87a63;
}

.summary__line {
  width: 1rpx;
  height: 48rpx;
  background: rgba(168, 122, 99, 0.22);
}

.tabs {
  display: flex;
  margin-top: 28rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(226, 160, 130, 0.12);
}

.tabs__item {
  flex: 1;
  height: 68rpx;
  border-radius: 999rpx;
  color: #9a8f8a;
  font-size: 26rpx;
  line-height: 68rpx;
  text-align: center;
}

.tabs__item--on {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff6b4a 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 74, 0.28);
}

.order {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(226, 160, 130, 0.14);
}

.order:active {
  opacity: 0.95;
}

.order__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order__no {
  color: #bcb2ad;
  font-size: 22rpx;
}

.order__summary {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.order__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.order__time {
  color: #9a8f8a;
  font-size: 22rpx;
}

.order__urge {
  color: #ff6b4a;
  font-size: 22rpx;
}

.order__remark {
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: #fdf8f5;
  color: #9a8f8a;
  font-size: 22rpx;
}

.order__ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
}

.order__btn {
  height: 68rpx;
  font-size: 26rpx;
}
