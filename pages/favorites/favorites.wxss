.head {
  margin-bottom: 24rpx;
  padding: 8rpx 4rpx;
}

.head__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #5a3324;
}

.head__tip {
  margin-top: 8rpx;
  color: #9a8f8a;
  font-size: 22rpx;
}

.go {
  width: 320rpx;
  height: 84rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff6b4a 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 74, 0.3);
}
