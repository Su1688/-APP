.detail {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.top {
  position: relative;
  height: 320rpx;
  border-radius: 32rpx;
  background: linear-gradient(150deg, #fff0e4 0%, #ffdfcd 55%, #ffe9cf 100%);
}

.top__emoji {
  font-size: 160rpx;
  line-height: 320rpx;
  text-align: center;
}

.top__img {
  width: 100%;
  height: 320rpx;
  display: block;
  border-radius: 32rpx;
}

.top--out {
  background: linear-gradient(150deg, #f6f2f0 0%, #efe9e6 100%);
}

.top--out .top__emoji {
  filter: grayscale(1);
  opacity: 0.55;
}

.top--out .top__img {
  filter: grayscale(1);
  opacity: 0.55;
}

.out-banner {
  margin-top: 24rpx;
  padding: 20rpx 26rpx;
  border-radius: 18rpx;
  background: #f2edeb;
  color: #9a8f8a;
  font-size: 24rpx;
  text-align: center;
}

.top__fav {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
}

.top__fav--on {
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 74, 0.24);
}

.head {
  margin-top: 26rpx;
}

.head__name-row {
  display: flex;
  align-items: center;
}

.head__name {
  font-size: 42rpx;
  font-weight: 700;
}

.head__spicy {
  margin-left: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #ffe9e2;
  color: #ff6b4a;
  font-size: 20rpx;
}

.head__desc {
  margin-top: 10rpx;
  color: #9a8f8a;
  font-size: 26rpx;
}

.head__tags {
  margin-top: 16rpx;
}

.facts {
  display: flex;
  margin-top: 28rpx;
  padding: 26rpx 0;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(226, 160, 130, 0.14);
}

.fact {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fact__num {
  font-size: 30rpx;
  font-weight: 700;
  color: #5a3324;
}

.fact__label {
  margin-top: 6rpx;
  color: #a87a63;
  font-size: 20rpx;
}

.block {
  padding: 26rpx 28rpx;
}

.ing {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.ing__dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 18rpx;
  border-radius: 999rpx;
  background: #ffb03a;
}

.step {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.step__no {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  margin-right: 18rpx;
  border-radius: 999rpx;
  background: #ffe9e2;
  color: #ff6b4a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 44rpx;
  text-align: center;
}

.step__text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
}

.bottom-space {
  height: 40rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: calc(132rpx + env(safe-area-inset-bottom));
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  padding-top: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #f3e9e3;
  box-shadow: 0 -6rpx 24rpx rgba(226, 160, 130, 0.1);
}

.bar__left {
  display: flex;
  align-items: center;
}

.bar__out {
  color: #bcb2ad;
  font-size: 26rpx;
}

.bar__btn {
  flex: 1;
  margin-left: 28rpx;
}
