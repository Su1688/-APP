.hero {
  position: relative;
  padding: 36rpx 36rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ffe7d9 0%, #ffd9c4 60%, #ffeacf 100%);
  overflow: hidden;
}

.hero__greet {
  font-size: 24rpx;
  color: #b07a5e;
}

.hero__title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #5a3324;
  letter-spacing: 1rpx;
}

.hero__sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a87a63;
}

.hero__emoji {
  position: absolute;
  right: 20rpx;
  bottom: -10rpx;
  font-size: 130rpx;
  opacity: 0.85;
}

.hero__text {
  position: relative;
  z-index: 1;
  padding-right: 130rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 86rpx;
  margin-top: 24rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(226, 160, 130, 0.14);
}

.search__icon {
  font-size: 28rpx;
  opacity: 0.7;
}

.search__input {
  flex: 1;
  margin-left: 14rpx;
  font-size: 26rpx;
}

.search__ph {
  color: #bcb2ad;
}

.search__clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #f3ece8;
  color: #9a8f8a;
  font-size: 22rpx;
  line-height: 44rpx;
  text-align: center;
}

.cats {
  margin-top: 24rpx;
  white-space: nowrap;
}

.cats__inner {
  display: inline-flex;
  padding-bottom: 6rpx;
}

.cat {
  display: inline-flex;
  align-items: center;
  margin-right: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #9a8f8a;
  font-size: 26rpx;
}

.cat--on {
  color: #fff;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff6b4a 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 74, 0.28);
  font-weight: 600;
}

.cat__emoji {
  margin-right: 8rpx;
}

.pref-hint {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 18rpx;
  background: #fff6e5;
  color: #b3812f;
  font-size: 22rpx;
}

.cartbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 116rpx;
  padding: 0 18rpx 0 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3d322d 0%, #2b2320 100%);
  box-shadow: 0 16rpx 36rpx rgba(58, 47, 43, 0.34);
}

.cartbar__left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.cartbar__bubble {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff6b4a 100%);
  text-align: center;
}

.cartbar__cart {
  font-size: 36rpx;
  line-height: 76rpx;
}

.cartbar__badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #ff6b4a;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.cartbar__text {
  margin-left: 20rpx;
}

.cartbar__title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.cartbar__tip {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
}

.cartbar__btn {
  flex: none;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff6b4a 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1002;
  background: rgba(47, 42, 40, 0.45);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1003;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  padding: 0 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
  transform: translateY(112%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
}

.sheet--on {
  transform: translateY(0);
}

.sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 0 18rpx;
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet__clear {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #f7f1ed;
  color: #9a8f8a;
  font-size: 22rpx;
}

.sheet__list {
  flex: 1;
  max-height: 44vh;
}

.sitem {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f6efeb;
}

.sitem__emoji {
  width: 72rpx;
  font-size: 40rpx;
}

.sitem__body {
  padding-right: 16rpx;
}

.sitem__name {
  font-size: 28rpx;
  font-weight: 600;
}

.sitem__desc {
  margin-top: 4rpx;
  color: #bcb2ad;
  font-size: 20rpx;
}

.sitem__ops {
  display: flex;
  align-items: center;
  flex: none;
}

.sheet__form {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #fdf8f5;
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__label {
  font-size: 26rpx;
  color: #6b5f59;
}

.field__value {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff6b4a;
}

.field__textarea {
  width: 100%;
  height: 108rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.field__ph {
  color: #bcb2ad;
  font-size: 24rpx;
}

.sheet__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.sheet__total {
  font-size: 24rpx;
  color: #9a8f8a;
}

.sheet__submit {
  flex: none;
}
