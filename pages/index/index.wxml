<view class="page page--tabbar">
  <view class="hero">
    <view class="hero__text">
      <view class="hero__greet">{{greet}}</view>
      <view class="hero__title" bindlongpress="onHoldTitle">今天想吃什么？</view>
      <view class="hero__sub">{{heroSub}}</view>
    </view>
    <view class="hero__emoji">🍳</view>
  </view>

  <view wx:if="{{moment}}" class="moment" bindtap="openMoment">
    <image
      wx:if="{{moment.cover}}"
      class="moment__cover"
      src="{{moment.cover}}"
      mode="aspectFill"
      lazy-load
    />
    <view class="moment__body">
      <view class="moment__badge">今天</view>
      <view class="moment__title">{{moment.title}}</view>
      <view class="moment__msg" wx:for="{{momentLines}}" wx:key="*this">{{item}}</view>
      <view class="moment__go">看看今天的菜单 ›</view>
    </view>
  </view>

  <view class="search">
    <text class="search__icon">🔍</text>
    <input
      class="search__input"
      value="{{keyword}}"
      placeholder="搜菜名，比如「番茄」"
      placeholder-class="search__ph"
      confirm-type="search"
      bindinput="onSearch"
    />
    <view wx:if="{{keyword}}" class="search__clear" bindtap="clearSearch">✕</view>
    <view wx:if="{{canRoll}}" class="search__dice" bindtap="openRoll">🎲</view>
  </view>

  <scroll-view class="cats" scroll-x show-scrollbar="{{false}}">
    <view class="cats__inner">
      <view
        class="cat {{activeCategory === item.id ? 'cat--on' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategory"
      >
        <text class="cat__emoji">{{item.emoji}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{prefHint}}" class="pref-hint">💡 {{prefHint}}</view>

  <block wx:if="{{refineList.length > 0}}">
    <view class="section-title">
      <view class="section-title__bar"></view>
      <text>本店招牌</text>
    </view>
    <dish-card
      wx:for="{{refineList}}"
      wx:key="id"
      dish="{{item}}"
      count="{{item.count}}"
      bind:add="onAdd"
      bind:minus="onMinus"
      bind:tapdish="onOpenDish"
      bind:egg="onEgg"
    />
  </block>

  <view class="section-title">
    <view class="section-title__bar"></view>
    <text>{{listTitle}}</text>
  </view>

  <dish-card
    wx:for="{{list}}"
    wx:key="id"
    dish="{{item}}"
    count="{{item.count}}"
    bind:add="onAdd"
    bind:minus="onMinus"
    bind:tapdish="onOpenDish"
    bind:egg="onEgg"
  />

  <empty-state
    wx:if="{{list.length === 0}}"
    emoji="🥺"
    text="没找到这道菜"
    hint="换个关键词，或者切回「全部」看看"
  />
</view>

<view wx:if="{{cartCount > 0}}" class="cartbar" bindtap="openCart">
  <view class="cartbar__left">
    <view class="cartbar__bubble">
      <text class="cartbar__cart">🛒</text>
      <text class="cartbar__badge">{{cartCount}}</text>
    </view>
    <view class="cartbar__text">
      <view class="cartbar__title">已点 {{cartCount}} 份</view>
      <view class="cartbar__tip">点一下看看都点了啥</view>
    </view>
  </view>
  <view class="cartbar__btn">去下单</view>
</view>

<view wx:if="{{showCart}}" class="mask" bindtap="closeCart"></view>

<view class="sheet {{showCart ? 'sheet--on' : ''}}">
  <view class="sheet__head">
    <text class="sheet__title">我的菜单</text>
    <text wx:if="{{cartItems.length > 0}}" class="sheet__clear" bindtap="onClearCart">清空</text>
  </view>

  <scroll-view class="sheet__list" scroll-y>
    <view class="sitem" wx:for="{{cartItems}}" wx:key="id">
      <text class="sitem__emoji">{{item.emoji}}</text>
      <view class="sitem__body flex-1">
        <view class="sitem__name ellipsis">{{item.name}}</view>
        <view class="sitem__desc ellipsis">{{item.desc}}</view>
      </view>
      <view class="sitem__ops">
        <view class="op op--minus" data-id="{{item.id}}" bindtap="onMinusTap">−</view>
        <text class="op-num">{{item.count}}</text>
        <view class="op op--add" data-id="{{item.id}}" bindtap="onAddTap">＋</view>
      </view>
    </view>
    <empty-state wx:if="{{cartItems.length === 0}}" emoji="🛒" text="菜单空啦" hint="回去挑几道菜吧" />
  </scroll-view>

  <view class="sheet__form">
    <view class="field">
      <text class="field__label">什么时候想吃</text>
      <picker mode="selector" range="{{timeOptions}}" value="{{timeIndex}}" bindchange="onTimeChange">
        <view class="field__value">{{expectTime}} ›</view>
      </picker>
    </view>
    <textarea
      class="field__textarea"
      value="{{remark}}"
      placeholder="有什么想跟大厨说的？比如「少放辣」「多留点汤」"
      placeholder-class="field__ph"
      maxlength="60"
      bindinput="onRemark"
    />
  </view>

  <view class="sheet__foot">
    <view class="sheet__total">共 {{cartItems.length}} 道菜 · {{cartCount}} 份</view>
    <view class="btn btn--primary sheet__submit" bindtap="submitOrder">告诉大厨 🍳</view>
  </view>
</view>

<view wx:if="{{hearts.length > 0}}" class="hearts">
  <text
    class="heart"
    wx:for="{{hearts}}"
    wx:key="key"
    style="left:{{item.left}}%;font-size:{{item.size}}rpx;animation-delay:{{item.delay}}s"
  >{{item.emoji}}</text>
</view>

<view wx:if="{{rollShow}}" class="mask" bindtap="closeRoll"></view>

<view class="sheet {{rollShow ? 'sheet--on' : ''}}">
  <view class="sheet__head">
    <text class="sheet__title">今天吃什么</text>
    <text class="sheet__clear" bindtap="closeRoll">收起</text>
  </view>

  <view class="roll">
    <view class="roll__name {{rolling ? 'roll__name--rolling' : ''}}">{{rollName}}</view>
    <view wx:if="{{rolling}}" class="roll__desc">正在翻菜单……</view>
    <block wx:else>
      <view class="roll__desc ellipsis-2">{{rollDish.desc}}</view>
      <view class="roll__meta">
        <text class="chip" wx:for="{{rollDish.tags}}" wx:key="*this">{{item}}</text>
        <text class="roll__min">⏱ {{rollDish.minutes}} 分钟</text>
      </view>
    </block>
  </view>

  <view class="sheet__foot">
    <view class="btn btn--plain" bindtap="rollAgain">再转一次</view>
    <view class="btn btn--primary" bindtap="addRolled">就它了，加上 🍳</view>
  </view>
</view>

<view wx:if="{{eggShow}}" class="egg" bindtap="closeEgg">
  <view class="egg__card">
    <image
      wx:if="{{longPress.photo}}"
      class="egg__photo"
      src="{{longPress.photo}}"
      mode="aspectFill"
    />
    <view wx:else class="egg__emoji">💌</view>
    <view class="egg__title">{{longPress.title}}</view>
    <view class="egg__text">{{longPress.text}}</view>
    <view class="egg__hint">点一下收起</view>
  </view>
</view>
