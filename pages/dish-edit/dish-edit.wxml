<view class="page edit">
  <view wx:if="{{isEdit && source === 'base'}}" class="hint">
    这是默认菜单里的菜，保存后会覆盖原来的内容
  </view>

  <view class="card block">
    <view class="label">菜品图</view>
    <view class="label__tip">拍一张你做的，她点单时看到的就是它</view>

    <view wx:if="{{form.image}}" class="photo">
      <image class="photo__img" src="{{form.image}}" mode="aspectFill" />
      <view class="photo__ops">
        <view class="photo__btn" bindtap="onPickImage">换一张</view>
        <view class="photo__btn photo__btn--danger" bindtap="onRemoveImage">删掉</view>
      </view>
    </view>

    <view wx:else class="photo-empty" bindtap="onPickImage">
      <view class="photo-empty__icon">📷</view>
      <view class="photo-empty__text">拍照 / 从相册选一张</view>
    </view>

    <view wx:if="{{!cloudReady}}" class="photo-warn">
      还没连上云开发，照片只存在这台手机上，她那台看不到
    </view>

    <view class="label label--gap">没照片时显示的图标</view>
    <view class="emoji-row">
      <view class="emoji-preview">{{form.emoji}}</view>
      <input
        class="emoji-input"
        value="{{form.emoji}}"
        maxlength="4"
        placeholder="也可以自己粘贴一个 emoji"
        placeholder-class="ph"
        bindinput="onEmojiInput"
      />
    </view>
    <view class="emoji-grid">
      <view
        class="emoji-cell {{form.emoji === item ? 'emoji-cell--on' : ''}}"
        wx:for="{{emojiPalette}}"
        wx:key="*this"
        data-emoji="{{item}}"
        bindtap="onPickEmoji"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view class="card block">
    <view class="label">菜名</view>
    <input
      class="input"
      value="{{form.name}}"
      maxlength="12"
      placeholder="比如「糖醋排骨」"
      placeholder-class="ph"
      bindinput="onName"
    />

    <view class="label label--gap">分类</view>
    <view class="chips">
      <view
        class="chip-btn {{form.category === item.id ? 'chip-btn--on' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategory"
      >
        {{item.emoji}} {{item.name}}
      </view>
    </view>

    <view class="label label--gap">一句话介绍</view>
    <input
      class="input"
      value="{{form.desc}}"
      maxlength="30"
      placeholder="比如「酸甜开胃，五分钟出锅」"
      placeholder-class="ph"
      bindinput="onDesc"
    />
  </view>

  <view class="card block">
    <view class="label">标签</view>
    <view class="chips">
      <view
        class="chip-btn {{item.on ? 'chip-btn--on' : ''}}"
        wx:for="{{tagOptions}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="onTag"
      >
        {{item.name}}
      </view>
    </view>

    <view class="label label--gap">辣度</view>
    <view class="chips">
      <view
        class="chip-btn {{form.spicy === index ? 'chip-btn--on' : ''}}"
        wx:for="{{spicyOptions}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onSpicy"
      >
        {{item}}
      </view>
    </view>

    <view class="label label--gap">难度</view>
    <view class="chips">
      <view
        class="chip-btn {{form.level === index + 1 ? 'chip-btn--on' : ''}}"
        wx:for="{{levelOptions}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onLevel"
      >
        {{item}}
      </view>
    </view>

    <view class="label label--gap">大概要做多久（分钟）</view>
    <input
      class="input"
      type="number"
      value="{{form.minutes}}"
      maxlength="4"
      placeholder="15"
      placeholder-class="ph"
      bindinput="onMinutes"
    />
  </view>

  <view class="card block">
    <view class="label">需要哪些食材</view>
    <view class="label__tip">一行写一样，例如「五花肉 500g」</view>
    <textarea
      class="textarea"
      value="{{form.ingredientsText}}"
      placeholder="五花肉 500g&#10;冰糖 20g&#10;生抽 2 勺"
      placeholder-class="ph"
      maxlength="500"
      bindinput="onIngredients"
    />

    <view class="label label--gap">大厨的做法</view>
    <view class="label__tip">一行写一步，写在详情页里给她看</view>
    <textarea
      class="textarea textarea--tall"
      value="{{form.stepsText}}"
      placeholder="五花肉切块焯水&#10;炒糖色后下肉翻炒上色&#10;加热水炖 40 分钟收汁"
      placeholder-class="ph"
      maxlength="1000"
      bindinput="onSteps"
    />
  </view>

  <view wx:if="{{isEdit}}" class="delete" bindtap="onDelete">删除这道菜</view>

  <view class="bottom-space"></view>
</view>

<view class="bar">
  <view class="btn btn--primary bar__btn" bindtap="onSave">
    {{isEdit ? '保存修改' : '加进菜单'}}
  </view>
</view>
