.page {
  padding-bottom: 60rpx;
}

.intro {
  padding: 28rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffe7d9 0%, #ffd9c4 60%, #ffeacf 100%);
}

.intro__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5a3324;
}

.intro__text {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #a87a63;
}

.tabs {
  display: flex;
  margin-top: 28rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(226, 160, 130, 0.14);
}

.tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #9a8f8a;
}

.tab--on {
  color: #fff;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff6b4a 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 74, 0.28);
  font-weight: 600;
}

.tab__emoji {
  margin-right: 6rpx;
}

.hint {
  margin: 20rpx 4rpx 0;
  font-size: 22rpx;
  color: #bcb2ad;
}

.lines {
  margin-top: 16rpx;
  padding: 6rpx 26rpx;
}

.line {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f6efeb;
}

.line:last-child {
  border-bottom: none;
}

.line__text {
  font-size: 27rpx;
  color: #4a3f3a;
}

.line__del {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #f7f1ed;
  color: #bcb2ad;
  font-size: 22rpx;
  line-height: 52rpx;
  text-align: center;
}

.line__del:active {
  color: #ff6b4a;
  background: #ffe9e2;
}

.empty {
  padding: 44rpx 0;
  color: #bcb2ad;
  font-size: 24rpx;
  text-align: center;
}

.add {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 18rpx 20rpx 18rpx 28rpx;
}

.add__input {
  flex: 1;
  font-size: 26rpx;
}

.add__ph {
  color: #bcb2ad;
  font-size: 24rpx;
}

.add__btn {
  flex: none;
  height: 68rpx;
  margin-left: 16rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}

.ops {
  display: flex;
  margin-top: 28rpx;
}

.ops__btn {
  flex: 1;
  height: 76rpx;
  font-size: 25rpx;
}

.ops__btn + .ops__btn {
  margin-left: 18rpx;
}

.tip {
  margin: 34rpx 8rpx 0;
  color: #bcb2ad;
  font-size: 22rpx;
  text-align: center;
}
