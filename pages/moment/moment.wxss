.page {
  padding-bottom: 220rpx;
}

.hero {
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #fff1e6 0%, #ffe2ea 55%, #f6e9ff 100%);
  box-shadow: 0 12rpx 30rpx rgba(226, 160, 130, 0.2);
}

.hero__cover {
  display: block;
  width: 100%;
  height: 420rpx;
}

.hero__body {
  padding: 34rpx 34rpx 36rpx;
}

.hero__badge {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #d4593f;
  font-size: 20rpx;
  font-weight: 600;
}

.hero__title {
  margin-top: 16rpx;
  color: #5a3324;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero__msg {
  margin-top: 16rpx;
  color: #8a5f4d;
  font-size: 27rpx;
  line-height: 1.75;
}

.hero__msg + .hero__msg {
  margin-top: 10rpx;
}

.orderbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 116rpx;
  padding: 0 18rpx 0 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3d322d 0%, #2b2320 100%);
  box-shadow: 0 16rpx 36rpx rgba(58, 47, 43, 0.34);
}

.orderbar__left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.orderbar__bubble {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff6b4a 100%);
  text-align: center;
}

.orderbar__cart {
  font-size: 36rpx;
  line-height: 76rpx;
}

.orderbar__badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #ff6b4a;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.orderbar__text {
  margin-left: 20rpx;
}

.orderbar__title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.orderbar__tip {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
}

.orderbar__btn {
  flex: none;
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8a5c 0%, #ff6b4a 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}
