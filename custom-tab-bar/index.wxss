.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #f3e9e3;
  box-shadow: 0 -6rpx 24rpx rgba(226, 160, 130, 0.1);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 108rpx;
  color: #9a8f8a;
}

.tab--on {
  color: #ff6b4a;
}

.tab__icon-wrap {
  position: relative;
  height: 44rpx;
  line-height: 44rpx;
}

.tab__icon {
  font-size: 36rpx;
  line-height: 44rpx;
  opacity: 0.55;
}

.tab--on .tab__icon {
  opacity: 1;
}

.tab__badge {
  position: absolute;
  top: -4rpx;
  right: -22rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ff6b4a;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.tab__text {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 26rpx;
}

.tab--on .tab__text {
  font-weight: 600;
}
